<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_search"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_search"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="com.explorer.fileexplorer.ACTION_SHORTCUT"
            android:targetPackage="com.explorer.fileexplorer"
            android:targetClass="com.explorer.fileexplorer.MainActivity">
            <extra android:name="shortcut_route" android:value="search" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

